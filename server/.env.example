# ============================================================
# DUTYFLOW - CẤU HÌNH BIẾN MÔI TRƯỜNG TOÀN HỆ THỐNG
# ============================================================
# Sau này khi bạn cần thay đổi Mật khẩu, Khóa bí mật hay Tên miền,
# bạn CHỈ CẦN sửa các giá trị dưới đây mà KHÔNG CẦN sửa lại mã nguồn!

# 1. CỔNG DỊCH VỤ & MÔI TRƯỜNG
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# 2. CƠ SỞ DỮ LIỆU (DATABASE MYSQL / TIDB CLOUD / AIVEN)
# Kết nối MySQL máy chủ hoặc Cloud:
DB_URL=jdbc:mysql://localhost:3306/duty?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh&characterEncoding=utf8
DB_USER=root
DB_PASSWORD=root
# Khi chạy đám mây không có MySQL (tự động dùng H2 embedded):
# DB_URL=jdbc:h2:file:./data/duty;MODE=MySQL;DATABASE_TO_UPPER=false;DB_CLOSE_DELAY=-1
# DB_USER=sa
# DB_PASSWORD=

# 3. BẢO MẬT PHIÊN ĐĂNG NHẬP & JWT
JWT_SECRET=dutyflow-enterprise-ultra-secure-key-min-32-chars-2026!
JWT_EXPIRATION=480

# 4. TƯỜNG LỬA MẠNG & CHỐNG GỌI TRỘM API (CORS ALLOWED ORIGINS)
# Chỉ các domain khai báo ở đây mới được quyền gọi API. Mọi trang web lạ khác sẽ bị chặn đứng ngay!
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080,https://donjaderoy-lich-kyta.hf.space,https://huggingface.co

# 5. CỤM CHỈ MỤC TÌM KIẾM ELASTICSEARCH
ELASTICSEARCH_URIS=http://localhost:9200

# 6. BỘ NHỚ ĐỆM REDIS / CACHE
REDIS_HOST=localhost
REDIS_PORT=6379
CACHE_TYPE=simple

# 7. TÍCH HỢP THÔNG BÁO ZALO DOANH NGHIỆP (NẾU CÓ)
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_ACCESS_TOKEN=
ZALO_REFRESH_TOKEN=
ZALO_CALLBACK_URL=http://localhost:8080/api/integrations/zalo/callback
ZALO_WEBHOOK_SECRET=
ZALO_TOKEN_CIPHER_KEY=
